# Copy to .env and fill in locally. .env is gitignored — never commit it.
# Every value below is a placeholder.

# Base URL of your Plex Media Server, as reachable from where you run the
# tools (no trailing slash). Used by e2e tests and optional HTTP verification.
PLEX_URL=http://plex-server.example:32400

# A Plex auth token for that server. Used only by e2e tests and curl checks.
PLEX_TOKEN=your-plex-token-placeholder

# Numeric id of the library section used by e2e tests (see /library/sections).
PLEX_SECTION_ID=1

# How Plex Media Server is installed: "linux" (distro package), "docker" or
# "podman" (changed in place through <engine> exec/cp). A container with a
# read-only root fs can't be changed in place: build a derived image (image/).
PLEX_INSTALL_TYPE=linux

# Directory that contains Plex Web's index.html. For containers this is the
# path INSIDE the container. Leave empty to auto-discover under the PMS install dir.
PLEX_WEB_DIR=

# docker/podman only: name or id of the PMS container (PLEX_DOCKER_CONTAINER
# is still accepted as an alias).
PLEX_CONTAINER=plex

# --- optional e2e settings (see BACKLOG.md B4/B5) ---------------------------
# Section ids for the broader e2e tests; each test skips when its id is unset.
# PLEX_E2E_TV_SECTION_ID=2
# PLEX_E2E_OTHER_SECTION_ID=3
# PLEX_E2E_BIG_SECTION_ID=4        # a library with 100+ items (queue windowing)
# A non-default sort your libraries offer (default: Year).
# PLEX_E2E_SORT_LABEL=Year
# route (default: inject the local build via interception) | server (after reapply.sh)
# PLEX_E2E_INJECT=route
# Force a player path in route mode: auto | primary | fallback | companion
# PLEX_E2E_PLAYER=auto
