# Copy to .env and fill in locally. .env is gitignored — never commit it.
# Every value below is a placeholder.

# Base URL of your Plex Media Server, as reachable from where you run the
# tools (no trailing slash). Used by e2e tests and optional HTTP verification.
PLEX_URL=http://plex-server.example:32400

# A Plex auth token for that server. Used only by e2e tests and curl checks.
PLEX_TOKEN=your-plex-token-placeholder

# Numeric id of the library section used by e2e tests (see /library/sections).
PLEX_SECTION_ID=1

# How Plex Media Server is installed: "linux" (distro package) or "docker".
PLEX_INSTALL_TYPE=linux

# Directory that contains Plex Web's index.html. For docker this is the path
# INSIDE the container. Leave empty to auto-discover under the PMS install dir.
PLEX_WEB_DIR=

# docker only: name or id of the PMS container.
PLEX_DOCKER_CONTAINER=plex
