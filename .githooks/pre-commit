#!/bin/sh
# Repo rule: run gitleaks and the test suite before every commit; never commit red.
set -eu

# Owner-only homelab material lives in the gitignored local/ directory. Refuse
# it even when force-added (git add -f), empty files included. Deleting a
# path there is allowed. (.gitleaks.toml has a matching rule for CI scans.)
local_paths=$(git diff --cached --name-only --diff-filter=d -- local/)
if [ -n "$local_paths" ]; then
  echo "pre-commit: refusing to commit files under local/ (owner-only, never public):" >&2
  printf '%s\n' "$local_paths" >&2
  echo "pre-commit: unstage them with: git restore --staged local/" >&2
  exit 1
fi

# Owner-defined private words (hostnames, image names, paths) live in the
# gitignored local/denylist.txt, one per line, no surrounding spaces; lines
# starting with # are comments. Refuse staged paths or added lines that
# contain any of them, ignoring case.
if [ -s local/denylist.txt ]; then
  # Fail closed: a missing or failing grep must block, never pass silently.
  command -v grep >/dev/null 2>&1 || { echo "pre-commit: grep is required to check local/denylist.txt" >&2; exit 1; }
  names=$(git diff --cached --name-only --diff-filter=d)
  lines=$(git diff --cached -U0 --no-color | awk '/^\+/ && !/^\+\+\+ /')
  found=""
  while IFS= read -r word || [ -n "$word" ]; do
    case "$word" in '' | '#'*) continue ;; esac
    rc=0
    printf '%s\n%s\n' "$names" "$lines" | grep -i -F -q -- "$word" || rc=$?
    case "$rc" in
      0) found="$found $word" ;;
      1) ;;
      *) echo "pre-commit: grep failed (exit $rc) while checking local/denylist.txt" >&2; exit 1 ;;
    esac
  done < local/denylist.txt
  if [ -n "$found" ]; then
    echo "pre-commit: staged changes contain words from local/denylist.txt:$found" >&2
    echo "pre-commit: replace them with placeholders (CLAUDE.md rule 1)" >&2
    exit 1
  fi
fi

# Minimum Node, same as "engines" in package.json (a unit test keeps them equal).
NODE_MIN_MAJOR=22
NODE_MIN_MINOR=12

node_ok() {
  command -v node >/dev/null 2>&1 || return 1
  v=$(node --version 2>/dev/null) || return 1
  v=${v#v}
  major=${v%%.*}
  rest=${v#*.}
  minor=${rest%%.*}
  [ "$major" -gt "$NODE_MIN_MAJOR" ] || { [ "$major" -eq "$NODE_MIN_MAJOR" ] && [ "$minor" -ge "$NODE_MIN_MINOR" ]; }
}

# GUI git clients (e.g. an editor's git panel) often run hooks without the
# shell setup that puts nvm's Node on PATH. Load nvm only when needed, so a
# Node from another version manager is left alone.
# nvm needs NVM_DIR exported when sourced from a non-bash sh (it cannot find
# its own directory there), exactly as its installer's shell snippet does.
if ! node_ok; then
  NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    export NVM_DIR
    set +eu
    . "$NVM_DIR/nvm.sh" >/dev/null 2>&1
    set -eu
  fi
fi
if ! node_ok; then
  echo "pre-commit: Node >= $NODE_MIN_MAJOR.$NODE_MIN_MINOR is required (found: $(node --version 2>/dev/null || echo none))." >&2
  echo "pre-commit: install it (e.g. nvm install $NODE_MIN_MAJOR) and retry." >&2
  exit 1
fi
echo "pre-commit: node $(node --version) ($(command -v node))"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not on PATH. Install it (see CLAUDE.md) and retry." >&2
  exit 1
fi

echo "pre-commit: gitleaks (staged changes)"
gitleaks git --pre-commit --staged --redact --no-banner .

echo "pre-commit: lint + typecheck"
npm run --silent lint

echo "pre-commit: unit tests"
npm test --silent
