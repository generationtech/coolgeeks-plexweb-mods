{
  "name": "coolgeeks-plexweb-mods",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime mods for a self-hosted Plex Web client, re-appliable after every Plex Media Server update.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preflight": "node dist/preflight.cjs",
    "reapply": "sh injector/reapply.sh",
    "secrets": "gitleaks git --redact --no-banner -v .",
    "secrets:staged": "gitleaks git --pre-commit --staged --redact --no-banner -v .",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "webpack": "5.112.2"
  }
}
